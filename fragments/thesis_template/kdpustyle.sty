% PREFACE
\newcommand{\preface}[1]{%
    \expandafter\gdef\csname preface@\endcsname{#1}}
\newcommand{\makepreface}{%
   \clearpage
   \titleformat{\chapter}[hang]{\large\center\bfseries}{\scshape\thechapter}{0 pt}{}%
   \titlespacing*{\chapter}{0pt}{-33 pt}{6 pt} % Key value is -33 pt   
   \chapter*{PREFACE}%
   \addcontentsline{toc}{chapter}{PREFACE} % This is to include this section in the Table of Contents}
   {\csname preface@\endcsname}%
}

% INTRODUCTION
\newcommand{\intro}[1]{%
    \expandafter\gdef\csname intro@\endcsname{#1}}
\newcommand{\makeintro}{%
   \clearpage
   \titleformat{\chapter}[hang]{\large\center\bfseries}{\scshape\thechapter}{0 pt}{}%
   \titlespacing*{\chapter}{0pt}{-33 pt}{6 pt} % Key value is -33 pt % https://www.overleaf.com/learn/latex/Questions/How_do_I_tab_(indent)_a_paragraph_in_LaTeX%3F
  \setlength{\parskip}{0 pt} % Same as Word file
  \setlength{\parindent}{0.5in} %
   \chapter*{INTRODUCTION}%
   \addcontentsline{toc}{chapter}{INTRODUCTION} % This is to include this section in the Table of Contents}
   {\csname intro@\endcsname}%
}

%  CONCLUSION
\newcommand{\conc}[1]{%
    \expandafter\gdef\csname conc@\endcsname{#1}}
\newcommand{\makeconc}{%
   \clearpage
   \titleformat{\chapter}[hang]{\large\center\bfseries}{\scshape\thechapter}{0 pt}{}%
   \titlespacing*{\chapter}{0pt}{-33 pt}{6 pt} % Key value is -33 pt   
   
   \setlength{\parskip}{0 pt} % Same as Word file
   \setlength{\parindent}{0.5in} %

   \chapter*{CONCLUSION}%
   \addcontentsline{toc}{chapter}{CONCLUSION} % This is to include this section in the Table of Contents}
   {\csname conc@\endcsname}%
}

