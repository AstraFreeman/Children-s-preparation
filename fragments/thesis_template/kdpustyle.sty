\newcommand{\cclicenseurl}[1]{%
  \expandafter\gdef\csname cclicenseurl@\endcsname{#1}}
  
\newcommand{\makecopyright}{%
  \vspace*{\fill} 
  \thispagestyle{empty}
  \begin{flushleft}%
  \MakeUppercase{\@title}  \vskip -0.5em%
  {COPYRIGHT} \vskip -0.5em%
  \@date \vskip -0.5em%
  {\csname authorlegal@\endcsname}
\end{flushleft}%
\clearpage
}

