@ARTICLE{Locastre2023417,
	author = {Locastre, Aline Vanessa and Alves, Carlos Monteiro and Dos Santos, Fabiana},
	title = {Digital Media and History Teaching: Reflections from a PIBID Project in Mato Grosso do Sul (2020-2022); [Mídias Digitais e Ensino de História: reflexões a partir de um projeto do PIBID no Mato Grosso do Sul (2020-2022)]},
