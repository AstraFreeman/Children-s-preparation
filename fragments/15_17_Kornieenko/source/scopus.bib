	abstract = {The New London Group (NLG) implored teachers to develop pedagogies that respond to cultural and linguistic diversity, and prepare students for increasingly multimodal and globally connected digital communication worlds that students negotiate. Immersive virtual reality (VR) simulates environments as three-dimensional representations, where the user experiences a sensory illusion in a new location, while the physical, real world is blocked from view within a head-mounted display. Immersive VR technology has become accessible in many homes and schools-anticipated to peak this decade. Research has found that virtual environments can be particularly effective for culturally and linguistically diverse learners, including L2 students, because they are engaged in a sensorial experience that enhances their sense of agency and practice language use within a life-like context. Additionally, the increasing affordability of immersive VR has improved accessibility, now widely used in higher education, schools, museums, and other informal learning and recreational spaces. © 2025 selection and editorial matter, Agustín Reyes-Torres, María Estela Brisk and Manel Lacorte; individual chapters, the contributors.}
}

@ARTICLE{Aslan2025,
	author = {Aslan, Serkan and Alanoğlu, Müslim and Karabatak, Songül},
	title = {Enhancing 21st-century teaching competencies: The key role of digital literacy in connecting pre-service teachers’ TPACK},
	year = {2025},
