	title = {Discovering the past through data: Promoting the design and analysis of original data-sets in history undergraduate courses in Hong Kong},
	year = {2015},
	journal = {International Journal of Pedagogies and Learning},
	volume = {10},
	number = {3},
	pages = {208 – 220},
	doi = {10.1080/22040552.2015.1135499},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85008870988&doi=10.1080%2f22040552.2015.1135499&partnerID=40&md5=319d84db5f6a3bc01efd16d57c37345d},
	abstract = {This article discusses the objectives and outcomes of a project to enhance digital humanities training at the undergraduate level in a Hong Kong university. The co-investigators re-designed a multi-source data-set as an example and then taught a multi-step curriculum about gathering, organizing, and presenting original data to an introductory history course for undergraduates in a broad-based admissions social science program. Undergraduates learned how to develop feasible topics, to search for data in different types of sources, to compile the data in spreadsheet format, and to describe the significance of the data for further research. This pilot curriculum enhanced the customary training for history students in the host institution which focuses primarily on qualitative analysis. © 2016 Informa UK Limited, trading as Taylor & Francis Group.},
	author_keywords = {Data curation; Digital humanities; History education; Original data}
}

@ARTICLE{Scholze2022113,
