}

@CONFERENCE{Avila-Alvarado202320,
	author = {Avila-Alvarado, Wendy and Muñoz, Mirna and Galvan-Cruz, Sergio and Mejía, Jezreel and Peña, Adriana},
	title = {Exploratory Analysis of Using Gamification in Software Engineering Education},
	year = {2023},
	journal = {CEUR Workshop Proceedings},
