	keywords = {Complex networks; Data acquisition; Environmental impact; Human computer interaction; Neural networks; Physiological models; Software engineering; Sustainable development; Coal region; Complex computation; Data collection; Decision dilemma; Energy transformation; Environment; Game approach; Heat maps; Neural-networks; Software technology; Serious games},
	editor = {Fang X.},
