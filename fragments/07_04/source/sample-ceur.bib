	keywords = {Game design; Project management; Risk assessment; Risk management; Software design; Students; Gamification; Knowledge areas; Management IS; Management skills; Real-world; Risks management; Software development projects; Software engineering education; Software project; Software project management; Serious games},
	publisher = {IEEE Computer Society}
}

@ARTICLE{Nguyen2023999,
	author = {Nguyen, Bao-An and Duong, Hoang-Thanh and Tsao, Ling-Ling and Chen, Hsi-Min},
	title = {An Educational Card Game Approach to Motivating the Learning of Software Engineering},
	year = {2023},
	journal = {Journal of Information Science and Engineering},
	volume = {39},
	number = {5},
	pages = {999 – 1022},
	doi = {10.6688/JISE.202309_39(5).0001},
