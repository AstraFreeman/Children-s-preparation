	publisher = {European Society for Engineering Education (SEFI)}
}

@ARTICLE{Gasca-Hurtado2019244,
	author = {Gasca-Hurtado, Gloria P. and Gómez-Álvarez, Maria C. and Manrique-Losada, Bell},
