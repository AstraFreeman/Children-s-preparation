	keywords = {Artificial intelligence; Computer software selection and evaluation; Information systems; Learning systems; Motivation; Software engineering; Teaching; Active learning strategies; Development process; Gamification; Personal Software Process; Poor performance; Student motivation; Teaching strategy; Team software process; Software design},
	editor = {Rocha A. and Reis L.P. and Cota M.P. and Goncalves R. and Suarez O.S.},
	publisher = {IEEE Computer Society}
}

@ARTICLE{Calderón201659,
