@CONFERENCE{Garaccione2023460,
	author = {Garaccione, Giacomo and Coppola, Riccardo and Ardito, Luca and Torchiano, Marco},
	title = {Gamification of Business Process Modeling Notation education: An experience report},
	year = {2023},
	journal = {ACM International Conference Proceeding Series},
	pages = {460 – 464},
	doi = {10.1145/3593434.3593956},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85162221763&doi=10.1145%2f3593434.3593956&partnerID=40&md5=d5b222c3cb758829d17cc2a91347d8da},
	abstract = {Business Process Modeling (BPM) is a skill considered fundamental for computer engineers, with Business Process Modeling Notation (BPMN) being one of the most commonly used notations for this discipline. BPMN modeling is present in different curricula in specific Master's Degree courses related to software engineering, but, in practice, students often underperform on BPMN modeling exercises due to difficulties in learning good modeling practices. In recent years, more and more fields of computer science have employed gamification (the usage of game elements in non-recreational contexts to gain benefits in terms of interest, participation, motivation, and enjoyment) with positive results during both development and teaching processes. Thus, we have developed a platform for BPMN modeling that employs gamification mechanics to facilitate learning good modeling practices with mechanisms such as rewarding good modeling solutions and penalizing less correct ones, with a dedicated feedback mechanism that maps correctly modeled elements to the corresponding concept. A preliminary laboratory experiment has been conducted with students of an Information Systems course to evaluate how students receive the mechanics and if there may be benefits in using a gamified environment for teaching process modeling throughout an entire course.  © 2023 ACM.},
	author_keywords = {BPMN Modeling; Computer Engineering; Education; Gamification; Process Modeling},
	keywords = {Curricula; Education computing; Engineering education; Learning systems; Process engineering; Software engineering; Teaching; Business process modeling; Business process modeling notation modeling; Computer engineering; Computer engineers; Experience report; Gamification; Good modelling practices; Modeling notation; Process-models; Teaching process; Students},
	publisher = {Association for Computing Machinery}
}

