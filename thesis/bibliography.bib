&amp;lt;p&amp;gt;&amp;lt;strong&amp;gt;ARTÃCULO COMPLETO:&amp;lt;/strong&amp;gt;&amp;lt;br /&amp;gt;&amp;lt;strong&amp;gt;&amp;lt;a href=&amp;quot;https://revistas.uned.es/index.php/ried/article/view/36246/27606&amp;quot;&amp;gt;https://revistas.uned.es/index.php/ried/article/view/36246/27606&amp;lt;/a&amp;gt;&amp;lt;/strong&amp;gt;&amp;lt;/p&amp;gt;}, number={2}, journal={{RIED-Revista Iberoamericana de Educación a Distancia}}, author={ Gonzalo Andrés {García Fernández} and Escribano Roca, Rodrigo}, year={2023}, month={abr.}, pages={69-87} 
