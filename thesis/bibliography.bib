@ARTICLE{Muñoz20235,
	author = {Muñoz, Mirna and Gasca-Hurtado, Gloria Piedad},
	title = {Gamification for addressing the challenges of teaching international Software Engineering standards in higher education institutions; [Gamificación para atender los desafíos de la enseñanza Ingeniería de Software en instituciones de educación superior]},
