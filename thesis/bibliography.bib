@ARTICLE{Makarova2019474,
	author = {Makarova, Nadezhda N. and Chernova, Nina V.},
	title = {Experience of using electronic educational resources in the process of teaching the History of Russia at the university; [Опыт применения электронных образовательных ресурсов в процессе преподавания истории России в университете]},
	year = {2019},
