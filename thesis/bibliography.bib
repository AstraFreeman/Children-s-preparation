@InProceedings{10.1007/978-3-030-00623-5_11,
	doi={10.1007/978-3-030-00623-5_11},
	author="Calder{\'o}n, Alejandro
	and Trinidad, Manuel
	and Ruiz, Mercedes
	and O'Connor, Rory V.",
	editor="Stamelos, Ioannis
	and O'Connor, Rory V.
	and Rout, Terry
	and Dorling, Alec",
	title="{Teaching Software Processes and Standards: A Review of Serious Games Approaches}",
	series="Communications in Computer and Information Science", volume= 918,
	booktitle="Software Process Improvement and Capability Determination",
	year="2018",
	publisher="Springer International Publishing",
	address="Cham",
	pages="154--166",
	abstract="Software process education is an important field within software engineering that requires a more practical and realistic, learning and teaching approach. In the context of education, serious games is a field that is growing rapidly as a way to provide alternative approaches to the traditional pedagogical learning/teaching process. The main objective of this work is to analyze the state of the art in relation to serious games for software process education with the aim to identify the current studies and existing serious games that deal with this field. A systematic literature review was performed following a predefined procedure that involves automatically searching in scientific digital databases. 152 papers were found by the automatic searches in the digital databases and 24 papers were selected as primary studies. Results show that researchers are more interested in addressing the design and use of serious games for software process education than the design of simulation models to support the design of serious games for software process education. Consequently, 21 serious games for software process education were identified and categorized.",
	isbn="978-3-030-00623-5"
}

