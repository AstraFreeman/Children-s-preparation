@CONFERENCE{Peixoto2015,
	author = {Peixoto, Mariana Maia and Silva, Carla},
	title = {{Requirements for gamified educational software: A systematic literature review; [Requisitos para softwares educacionais gamificados: Uma revisão sistemática de literatura]}},
