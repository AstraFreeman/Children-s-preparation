	publisher = {IEEE Computer Society}
}

@ARTICLE{Soares2022242,
	author = {Soares, Elziane Monteiro and Oliveira, Sandro Ronaldo Bezerra and Elgrably, Isaac Souza and Monteiro, Rodrigo Henrique Barbosa},
	title = {Application of a Gamified Approach to Learning in the Treatment of Problems in Software Process Improvement: Analysis and Discussion of Results},
	year = {2022},
