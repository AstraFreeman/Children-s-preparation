	doi = {10.1145/3639478.3639804},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85194854170&doi=10.1145%2f3639478.3639804&partnerID=40&md5=ff2ebbc1834297661447ef6339ec46f9},
	abstract = {Nowadays, learning management systems (LMSs) are established tools in higher education, especially in the domain of software engineering (SE). However, the potential of such educational technologies has not been fully exploited, as student performance in SE education is still strongly dependent on feedback from timeconstrained lecturers and tutors. Moreover, current LMSs are not designed for SE courses, as external SE tools are required to fulfill the requirements of lecturers such as programming and UML modeling features. Evolving these LMSs in the direction of intelligent tutoring could assist students in receiving automatic, individual feedback from the LMSs on their learning performance at any time. Also, gamified learning elements can serve to motivate students to engage with SE materials. Therefore, this paper presents an approach combining learning analytics, feedback, and interactive learning such as gamification in one LMS designed for SE education. The system could thus address diverse students with different backgrounds and motivational aspects and provide appropriate individual support to ensure effective SE education. © 2024 IEEE Computer Society. All rights reserved.},
	author_keywords = {Feedback; Gamification; Intelligent Tutoring System; Learning Analytics; Software Engineering Education; Student Motivation},
	keywords = {Education computing; Engineering education; Learning systems; Software engineering; Gamification; High educations; Intelligent tutoring; Intelligent tutoring system; Learning analytic; Learning management system; Software engineering education; Student motivation; Student performance; Tutoring system; Students},
	publisher = {IEEE Computer Society}
}

@ARTICLE{Mercader20205133,
	author = {Mercader, Cristina},
	title = {Explanatory model of barriers to integration of digital technologies in higher education institutions},
	year = {2020},
	journal = {Education and Information Technologies},
	volume = {25},
	number = {6},
	pages = {5133 – 5147},
	doi = {10.1007/s10639-020-10222-3},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85086025768&doi=10.1007%2fs10639-020-10222-3&partnerID=40&md5=3065bbca906418b31da21b1ca5491490},
	abstract = {Digital technologies are powerful resources that have not been globally integrated in higher education teaching. Previous studies have pointed out several barriers that can slow down this integration. This study, therefore, aims to elaborate an explanatory model of the barriers to digital technology integration into university teaching, including both links between them and between social and demographic factors that may be influencing them. Through a mixed method approach, a multiple case study with a sample of 527 teachers was developed in Spain. The results show that there are seven main barriers to technology integration: technophobia, lack of time, absence of planning, lack of incentives, lack of evaluation, work saturation, and university accreditation model. The model will help organizations and teachers to identify both the specific barriers and their linkages to other factors. Thus, they will be able to carry out improvements regarding the integration of digital technologies in higher education. © 2020, Springer Science+Business Media, LLC, part of Springer Nature.},
	author_keywords = {Barriers; Educational technology; Higher education; Model; Teaching}
}

@BOOK{Mills202586,
	author = {Mills, Kathy A. and Brown, Alinta and Gutierrez, Amanda},
	title = {Virtual Reality Street Art with L2 Learners as Multimodal Literacy},
	year = {2025},
	journal = {Multiliteracies, Multimodality, and Learning by Design in Second Language Learning and Teacher Education},
	pages = {86 – 102},
	doi = {10.4324/9781032620497-8},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105002865440&doi=10.4324%2f9781032620497-8&partnerID=40&md5=57fd37416ea9ad18931b98207c8dda39},
	abstract = {The New London Group (NLG) implored teachers to develop pedagogies that respond to cultural and linguistic diversity, and prepare students for increasingly multimodal and globally connected digital communication worlds that students negotiate. Immersive virtual reality (VR) simulates environments as three-dimensional representations, where the user experiences a sensory illusion in a new location, while the physical, real world is blocked from view within a head-mounted display. Immersive VR technology has become accessible in many homes and schools-anticipated to peak this decade. Research has found that virtual environments can be particularly effective for culturally and linguistically diverse learners, including L2 students, because they are engaged in a sensorial experience that enhances their sense of agency and practice language use within a life-like context. Additionally, the increasing affordability of immersive VR has improved accessibility, now widely used in higher education, schools, museums, and other informal learning and recreational spaces. © 2025 selection and editorial matter, Agustín Reyes-Torres, María Estela Brisk and Manel Lacorte; individual chapters, the contributors.}
}

@CONFERENCE{Moallem2006167,
	author = {Moallem, Mahnaz},
	title = {Exploring synchronous learning management systems: A conceptual design and development model},
	year = {2006},
	journal = {IADIS International Conference on Cognition and Exploratory Learning in Digital Age, CELDA 2006},
	pages = {167 – 177},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84883017180&partnerID=40&md5=f94aeb0d0cc92f902fee727ac06999ff},
	abstract = {The purpose of this paper is to demonstrate how new synchronous learning management systems can be integrated with asynchronous communication tools in online learning environments in order to increase level of cognitive activity, social presence and collaborative learning process. It will provide an exploratory design model for convergence of synchronous and asynchronous communication tools in online courses. The model will show how and in what ways designers can use multiple communication tools to promote social interaction, cognition and collaborative learning. The paper will also report the results of an evaluation study on how the convergence model makes it possible to provide richer, more social and interactive learning experiences. The evaluation results suggests that integrating use of new synchronous or real time learning management systems with existing learning management tools for online learning provide more opportunities for social interaction, immediate feedback and sense of social presence. Students' higher satisfaction and low drop out rate along with stronger sense of community and more complex cognitive abilities show promises for quality of online learning environments.},
