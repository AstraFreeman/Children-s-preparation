	keywords = {Behavioral research; Computer aided software engineering; E-learning; Statistics; Co-creation; Collaborative learning; Digital simulation; Educational outcomes; Edutainment; Students},
	publisher = {Elsevier Ltd},
  pages = {103813},
}
