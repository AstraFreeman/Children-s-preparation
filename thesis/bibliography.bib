}

@CONFERENCE{Begosso201927,
	author = {Begosso, Luiz Ricardo and Franco, Luis Henrique Buzzo and Da Cunha, Douglas Sanches and Begosso, Luiz Carlos},
	title = {Simscrumf: A game for supporting the process of teaching Scrum},
