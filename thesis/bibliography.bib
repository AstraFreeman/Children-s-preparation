	abstract = {RIPPLE, a model for addressing numerous barriers to the integration of instructional technology into higher education, is discussed. Results from literature review, the questionnaire, and personal experiences with change were used in constructing the model for integrating instructional technology into higher education. The elements of the model are: resources, infrastructure, people, policies, learning, evaluation, and support. Infrastruture refers to the significant importance of a college's hardware, software, facilities and network infrastructure. Policies refers to the need for organizational policies and procedures to adjust to new technologies. The elements of the RIPPLES model are properly grounded in theory and practical experience.}
}

@CONFERENCE{Takbiri2019,
