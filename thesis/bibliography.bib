  publisher = {John Wiley \& Sons},
  doi = {10.1002/9781119100812.ch23},
  pages = {553--577},
  abstract = {This chapter synthesizes scholarship illuminating the purposes, promises, and challenges for integrating digitally mediated tools in history education. We begin by exploring the discipline of history from a digital perspective before attending to two key features of this broad landscape: digitally mediated simulations and computer-based gaming-including the use of online, console, and app-based environments. The primary focus of this chapter is on K-12 uses of these environments. Given the nascent nature of the digital paradigm for history education, we draw lessons from a range of innovative fields including historical research, private industry, teacher education, and K-12 education. We conclude the chapter by identifying areas for further development and research imagining a future in history education where digital environments are a platform for innovation in history education. © 2018 John Wiley & Sons, Inc. All rights reserved.},
