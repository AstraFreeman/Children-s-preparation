	keywords = {Curricula; Gamification; Software engineering; Teaching; Computer Science course; Computer technology; Evaluation criteria; Experience report; Face to face; Online learning; Planning and design; Remote teaching; E-learning},
	publisher = {Association for Computing Machinery}
}

