@ARTICLE{Reyes2024,
	author = {Reyes, Yilena Montero and Córdova, Alba Viviana Herrera and Capa, Lucia Efigenia Pardo and Avilés, Orlando Máximo Torrales and Leon, Betty Alexandra Villalta},
	title = {Interactive strategies for teaching history: The impact of Genially on motivation and learning; [Estrategias interactivas para la enseñanza de la Historia: El impacto de Genially en la motivación y el aprendizaje]},
