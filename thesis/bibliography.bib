@ARTICLE{Yamani202114,
	author = {Yamani, Hanaa Abdulraheem},
	title = {A Conceptual Framework for Integrating Gamification in eLearning Systems Based on Instructional Design Model},
	year = {2021},
	journal = {International Journal of Emerging Technologies in Learning},
	volume = {16},
	number = {4},
	pages = {14 – 33},
