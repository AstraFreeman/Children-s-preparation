@inproceedings{10.1145/3555858.3555912,
	author = {Legaki, Nikoletta-Zampeta and Thibault, Mattia and Hamari, Juho},
	title = {{Gamified Educational Software for Data Literacy - A Research Through Design Approach to GANDALF}},
