@inproceedings{50Lye2013,
doi={10.1109/ICCSE.2013.6554007},
Author = {Lye, Lim Eng and Sabri, Mas Idayu Binti Md},
Title = {{Learning History Through Computer Game Authoring}},
  booktitle={{2013 8th International Conference on Computer Science \& Education}}, 
Year = {2013},
Pages = {746-750},
Abstract = {Recent researches showed that computer game authoring is able to help
   students to acquire mathematics and science knowledge in the classroom.
   The researchers believe that this method is able to apply for the other
   subject matters. The subject matter that the researchers focused in this
   paper is history learning. Firstly, this paper describes the process of
   game authoring workshop for history learning environment. Next, we
   analyzed participants' perspectives through interviews to seek for the
   learning experiences of using this method in history learning context.
   Lastly, we look into the feasibility of creating 2D computer game
   environment to support history learning and the participant's experience
   towards the authoring tool being used in this study. There are five
   participants in this workshop; all the participants have no prior
   experience in computer game authoring. In most of the approaches,
