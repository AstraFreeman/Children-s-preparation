@ARTICLE{Lopez-Fernandez202474045,
	author = {Lopez-Fernandez, Daniel and Tovar, Edmundo and Gordillo, Aldo and Gayoso-Cabada, Joaquin and Badenes-Olmedo, Carlos and Cimmino, Andrea},
	title = {Comparing a LEGO® Serious Play Activity With a Traditional Lecture in Software Engineering Education},
	year = {2024},
	journal = {IEEE Access},
